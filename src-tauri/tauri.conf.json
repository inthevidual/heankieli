{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlumppuVox Heänkieli",
  "version": "0.1.0",
  "identifier": "com.plumppu.heankieli",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PlumppuVox Heänkieli",
        "width": 1360,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 680,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' http://127.0.0.1:* blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "app", "nsis", "msi"],
    "category": "Video",
    "shortDescription": "Local transcription and subtitles",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
